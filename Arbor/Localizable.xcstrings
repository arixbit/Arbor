        }
      }
    },
    "Only the local branch reference will be removed. Unmerged commits remain in the repository until garbage collection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会删除本地分支引用。未合并的提交会保留在仓库中，直到垃圾回收。"
