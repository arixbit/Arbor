    },
    "One path per line; use an absolute path to target one Git root. Leave empty to show all updated paths." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行一个路径；使用绝对路径可定位到单个 Git root。留空显示所有已更新路径。"
          }
        }
      }
    },
    "One regular expression per line. Force push is blocked for matching branches; main and master are protected by default." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行一个正则表达式。匹配的分支会阻止强制推送；默认保护 main 和 master。"
          }
        }
      }
    },
    "One selected revision will be used for each Git root." : {
      "localizations" : {
        "zh-Hans" : {
