        }
      }
    },
    "Only the user@host and method are stored; credentials and SSH agent secrets are never saved here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里只保存 user@host 和认证方式；凭证与 SSH agent 秘密不会保存在这里。"
