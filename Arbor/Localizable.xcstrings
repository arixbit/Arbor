    "Arbor" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbor"
          }
        }
      }
    },
    "Arbor Embedded is selected only for Arbor signing sessions; other GPG callers continue to use the detected system pinentry. Use the system option when GnuPG is managed externally." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbor 内置 pinentry 仅用于 Arbor 的签名会话；其他 GPG 调用方仍使用检测到的系统 pinentry。GnuPG 由外部管理时请使用系统选项。"
          }
        }
      }
    },
    "Arbor helps you review changes, manage branches, resolve conflicts, and work with Git remotes in a focused native macOS app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbor 帮助你在专注的原生 macOS 应用中查看变更、管理分支、解决冲突并使用 Git 远程仓库。"
          }
        }
      }
    },
    "Arbor records operation names, version, repository basename, and error codes only." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbor 仅记录操作名称、版本、仓库名称和错误码。"
          }
        }
      }
    },
    "Arbor uses the system GPG agent. Configure an external pinentry program, back up the existing agent config, and reload the agent before retrying a signed commit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbor 使用系统 GPG agent。请配置外部 pinentry 程序、备份现有 agent 配置，并在重试签名提交前重新加载 agent。"
          }
        }
      }
    },
